NODE_ENV=development
IP=localhost
PORT=3005

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=event_server
DB_USER=root
DB_PASSWORD=
DB_LOG=false
DB_POOL_MAX=50

# Internal API key for service-to-service calls
INTERNAL_API_KEY=

# Webhook delivery security
# WEBHOOK_EGRESS_MODE controls where subscribers may point their webhook URLs:
#   internal  — any host (default; the event bus lives in a trusted docker network)
#   public    — block private/loopback/link-local/metadata IPs (anti-SSRF for mixed networks)
#   allowlist — only hosts from WEBHOOK_ALLOW_HOSTS (comma-separated)
WEBHOOK_EGRESS_MODE=internal
WEBHOOK_ALLOW_HOSTS=
# An event with zero active subscribers is re-pended with deliverAfter pushed
# out by this many ms (it is NOT finalized as delivered — nothing was delivered).
# If the pattern never gains a subscriber, TTL cleanup deletes the event as usual.
EVENT_NO_SUBSCRIBER_RETRY_MS=60000
# Optional per-subscriber HMAC secrets: subscribers pass `secret` (min 32 chars)
# at POST /subscribe — both sides must know it (e.g. message-server WEBHOOK_SECRET);
# or generateSecret: true returns one exactly once (rotate via
# POST /subscribe/:id/rotate). Subscribers with a secret receive
# X-Event-Signature / X-Event-Timestamp headers instead of the shared internal key.

# Delivery worker
WORKER_INTERVAL_MS=500
WORKER_MAX_INTERVAL_MS=2000
WORKER_STALE_TIMEOUT_MS=300000
CLEANUP_INTERVAL_MS=3600000
BATCH_SIZE=50

# Delivery settings
DEFAULT_HTTP_TIMEOUT_MS=10000
CIRCUIT_BREAKER_THRESHOLD=5

# Event validation
EVENT_STRICT_MODE=false

# Documentation
SWAGGER_PREFIX=swagger
SWAGGER_PREFIX_REDOC=redoc
SWAGGER_TITLE=Event Server API
SWAGGER_DESCRIPTION=Central event broker
SWAGGER_VERSION=1.0

# Infrastructure (optional)
SENTRY_DSN=
SENTRY_ENV=localhost

# Logging
LOG_FORMAT=console # LOG_FORMAT=json for structured logs + request id
MORGAN_LOG_FORMAT=dev
